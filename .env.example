# Copy to .env. Do not commit .env.
AWS_REGION=ap-southeast-2
AWS_PROFILE=
# Optional. When set, ApplyGuardrail assumes this role. The Responses API uses the key below.
APP_ROLE_ARN=

# Local secrets. Generate long random values. Never commit the real ones.
SESSION_SECRET=
TOTP_KEY=
DATABASE_PATH=data/mops.sqlite
AUDIT_LOG_PATH=data/audit.log

# Bedrock Mantle OpenAI-compatible Responses API. Not api.openai.com.
OPENAI_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
OPENAI_API_KEY=
BEDROCK_MODEL_ID=

GUARDRAIL_ID=
GUARDRAIL_VERSION=

AI_MAX_TOKENS=800
AI_DAILY_CAP=40
PORT=3001
CORS_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3001
