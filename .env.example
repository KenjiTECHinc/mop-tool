# Copy to .env. Do not commit .env.
AWS_REGION=ap-southeast-2
AWS_PROFILE=
# Optional IAM override. When AWS_PROFILE or APP_ROLE_ARN is set, Converse and
# ApplyGuardrail use that role instead of the Bedrock API key.
APP_ROLE_ARN=

# Local secrets. Generate long random values. Never commit the real ones.
SESSION_SECRET=
TOTP_KEY=
# Optional. Uncomment so T1 (Ada) can use the code 000000 in a local demo.
# Off by default. Docker Compose does not turn this on. The API logs a warning at startup when it is true.
# Do not enable this in a real deployment.
# DEMO_TOTP_BYPASS=true
# Optional. When set, `npm run seed` gives every demo user this password (12 to 200 characters)
# and prints a warning. Leave it empty to generate a random password per user, printed once.
# Local demo only. Do not use a fixed password in a real deployment.
DEMO_PASSWORD=123456789012
DATABASE_PATH=data/mops.sqlite
AUDIT_LOG_PATH=data/audit.log

# 30-day long-term Bedrock API key for local/demo use. Server-side only.
# Create it in the Bedrock console (API keys -> Long-term). Never commit the value.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=

GUARDRAIL_ID=
GUARDRAIL_VERSION=

AI_MAX_TOKENS=800
AI_DAILY_CAP=40
PORT=3001
CORS_ORIGIN=http://localhost:5173

VITE_API_URL=http://localhost:3001
