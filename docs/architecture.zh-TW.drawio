        <mxCell id="step-9-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Noto Sans CJK TC;" value="&lt;div&gt;&lt;b&gt;套用防護欄&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;同一個 Bedrock 用戶端在設定 GUARDRAIL_ID 時呼叫 ApplyGuardrail。&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-9-legend">
          <mxGeometry x="52" width="640" height="70" as="geometry" />
        </mxCell>

        <mxCell id="legend-line-styles" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontFamily=Noto Sans CJK TC;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontColor=#232F3E;" value="&lt;b&gt;線條&lt;/b&gt;&lt;br&gt;實線：請求路徑。Bedrock 以 API 金鑰（Bearer）呼叫，不是 IAM。&lt;br&gt;虛線：選用。只有設定 AWS_PROFILE 或 APP_ROLE_ARN 時才使用 MopsApiRole。Budgets 的 mops-one-dollar 是選用的每月花費警示。" vertex="1" parent="legend-container">
          <mxGeometry x="0" y="784" width="700" height="140" as="geometry" />
